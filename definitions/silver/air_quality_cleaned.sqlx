config {
    type: "table",
    schema: "processed_layer",
    name: "air_quality_cleaned",
    description: "Cleaned and deduplicated air quality sensor data",
    bigquery: {
        partitionBy: "DATE(timestamp)",
        clusterBy: ["zone_id"]
    },
    assertions: {
        uniqueKey: ["sensor_id", "timestamp"],
        nonNull: ["sensor_id", "zone_id", "timestamp"]
    },
    tags: ["silver", "air_quality"]
}

WITH deduplicated AS (
    SELECT
        *,
        ROW_NUMBER() OVER (
            PARTITION BY sensor_id, timestamp
            ORDER BY ingested_at DESC
        ) AS row_num
    FROM ${ref("air_quality_raw")}
    WHERE
        co2_ppm      IS NOT NULL
        AND pm25_ugm3  IS NOT NULL
        AND aqi_score  IS NOT NULL
        AND co2_ppm    BETWEEN 0 AND 5000
        AND pm25_ugm3  BETWEEN 0 AND 500
        AND aqi_score  BETWEEN 0 AND 500
)

SELECT
    sensor_id,
    zone_id,
    TIMESTAMP(timestamp)        AS timestamp,
    ROUND(co2_ppm, 2)           AS co2_ppm,
    ROUND(pm25_ugm3, 2)         AS pm25_ugm3,
    aqi_score,
    ROUND(temperature_c, 2)     AS temperature_c,
    ROUND(humidity_pct, 2)      AS humidity_pct,
    source,
    TIMESTAMP(ingested_at)      AS ingested_at,
    DATE(timestamp)             AS date,
    EXTRACT(HOUR FROM TIMESTAMP(timestamp)) AS hour_of_day,
    CASE
        WHEN aqi_score <= 50  THEN 'GOOD'
        WHEN aqi_score <= 100 THEN 'MODERATE'
        WHEN aqi_score <= 150 THEN 'UNHEALTHY_SENSITIVE'
        WHEN aqi_score <= 200 THEN 'UNHEALTHY'
        WHEN aqi_score <= 300 THEN 'VERY_UNHEALTHY'
        ELSE                       'HAZARDOUS'
    END AS aqi_category,
    CASE WHEN aqi_score > 150 THEN TRUE ELSE FALSE END AS requires_alert
FROM deduplicated
WHERE row_num = 1